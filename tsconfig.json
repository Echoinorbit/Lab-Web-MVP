{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/shared/components/endfield/*"],
      "@/content": ["src/shared/components/endfield/content/index.ts"],
      "@/content/*": ["src/shared/components/endfield/content/*"],
      "@/hooks/useScrollSpy": ["src/shared/components/endfield/hooks/useScrollSpy.ts"],
      "@/lib/bulletin": ["src/shared/components/endfield/lib/bulletin.ts"],
      "@/lib/media": ["src/shared/components/endfield/lib/media.ts"],
      "@/lib/utils": ["src/shared/lib/utils.ts"],
      "@/types/site": ["src/shared/components/endfield/types/site.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".agents", ".claude", ".omc", ".omo", ".omx"]
}
